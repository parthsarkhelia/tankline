{
  "info": {
    "name": "tankline",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Chicago to Denver",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"has fuel stops\", () => pm.expect(pm.response.json().fuel_stops.length).to.be.above(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/plan/?start=Chicago, IL&finish=Denver, CO",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "plan"
          ],
          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            },
            {
              "key": "finish",
              "value": "Denver, CO"
            }
          ]
        }
      }
    },
    {
      "name": "Coast to coast",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"at least 5 stops\", () => pm.expect(pm.response.json().summary.stops).to.be.at.least(5));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/plan/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "plan"
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        }
      }
    },
    {
      "name": "ZIP and coordinates",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/plan/?start=10001&finish=34.0522,-118.2437",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "plan"
          ],
          "query": [
            {
              "key": "start",
              "value": "10001"
            },
            {
              "key": "finish",
              "value": "34.0522,-118.2437"
            }
          ]
        }
      }
    },
    {
      "name": "Starting with a full tank",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"no fuel bought\", () => pm.expect(pm.response.json().summary.total_cost).to.eql(\"0.00\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/plan/?start=Chicago, IL&finish=St. Louis, MO&start_fuel_miles=500",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "plan"
