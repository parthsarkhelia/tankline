          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            },
            {
              "key": "finish",
              "value": "St. Louis, MO"
            },
            {
              "key": "start_fuel_miles",
              "value": "500"
            }
          ]
        }
      }
    },
    {
      "name": "Ambiguous place",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"ambiguous_location\", () => pm.expect(pm.response.json().error.code).to.eql(\"ambiguous_location\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/plan/?start=Springfield&finish=Chicago, IL",
