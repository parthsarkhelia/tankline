# Free key from https://openrouteservice.org (dashboard -> API keys)
ORS_API_KEY=
# "osrm" = public OSRM car routing, no key (default, saves quota)
# "ors"  = OpenRouteService truck routing (driving-hgv) with OSRM fallback; needs ORS_API_KEY
ROUTING_PROVIDER=osrm
# Signs nothing here (no sessions, auth or CSRF), but Django requires one when DEBUG is off.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
API_THROTTLE_RATE=30/min
ORS_DAILY_BUDGET=150
POSTGRES_PASSWORD=tankline
